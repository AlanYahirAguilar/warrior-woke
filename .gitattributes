# Normaliza fin de línea a LF para todo archivo de texto.
# Evita diffs gigantes/falsos cuando el equipo mezcla Windows y macOS/Linux.
* text=auto eol=lf

# Código fuente
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.compute text

# Archivos YAML de Unity: se tratan como texto (Force Text ya está activado
# en ProjectSettings/EditorSettings.asset) y usan el merge driver de Unity
# para resolver conflictos de escenas/prefabs de forma inteligente en vez de
# un diff de texto plano. Requiere registrar el driver una vez por máquina;
# ver docs/contexto.md §12 -> "Merge inteligente de Unity".
*.unity text merge=unityyamlmerge eol=lf linguist-generated
*.prefab text merge=unityyamlmerge eol=lf linguist-generated
*.asset text merge=unityyamlmerge eol=lf linguist-generated
*.mat text merge=unityyamlmerge eol=lf linguist-generated
*.anim text merge=unityyamlmerge eol=lf linguist-generated
*.controller text merge=unityyamlmerge eol=lf linguist-generated
*.physicsMaterial2D text merge=unityyamlmerge eol=lf linguist-generated
*.physicsMaterial text merge=unityyamlmerge eol=lf linguist-generated
*.meta text merge=unityyamlmerge eol=lf linguist-generated -diff

# LightingData.asset es BINARIO aunque la serialización sea Force Text.
# Debe ir después de la regla *.asset para anularla; si git le convierte
# los finales de línea, corrompe la iluminación horneada.
LightingData.asset binary

# Binarios: nunca como texto, para que git no intente diff/convertir line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.blend binary
*.3ds binary
*.ttf binary
*.otf binary
*.dll binary
*.unitypackage binary
*.cubemap binary

